{
  "name": "@agrogarantias/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/copy-maplibre-worker.mjs && node scripts/prepare-scanner-assets.mjs && next build && node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/apps/web/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/prepare-scanner-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
