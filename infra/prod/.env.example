# =============================================================================
# AgroGarantías — variables del servidor (piloto). Copiar a infra/prod/.env.
# Generar los secretos con: scripts/prod/gen-secrets.sh > infra/prod/.env.secrets
# NUNCA commitear infra/prod/.env.
# =============================================================================

# Dominios (registros DNS tipo A apuntando a la IP del servidor)
APP_DOMAIN=app.ejemplo.com.ar
FILES_DOMAIN=archivos.ejemplo.com.ar
# Email para Let's Encrypt (avisos de certificados)
ACME_EMAIL=infra@ejemplo.com.ar

# Base de datos
POSTGRES_DB=agrogarantias
POSTGRES_USER=agro
POSTGRES_PASSWORD=CAMBIAR

# Almacenamiento (MinIO)
MINIO_ROOT_USER=agro_minio
MINIO_ROOT_PASSWORD=CAMBIAR
S3_BUCKET=agrogarantias

# Secretos de la aplicación (mínimo 32 caracteres)
JWT_ACCESS_SECRET=CAMBIAR
AI_SERVICE_TOKEN=CAMBIAR

# Proveedores reales
CV_PROVIDER=ai-service
SATELLITE_PROVIDER=stac
# mock: las fichas de registro se muestran marcadas SIMULADO. senasa: requiere convenio y
# credenciales (SENASA_API_URL, SENASA_CLIENT_ID, SENASA_CLIENT_SECRET); sin ellas responde error.
REGISTRY_PROVIDER=mock

# Límites
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10
LOG_LEVEL=info
