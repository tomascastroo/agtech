{
  "name": "agrogarantias",
  "private": true,
  "description": "AgroGarant\u00edas \u2014 verificaci\u00f3n remota y recurrente de activos agropecuarios",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r --filter ./apps/* run build",
    "test": "pnpm --filter @agrogarantias/api test && pnpm --filter @agrogarantias/web test",
    "test:e2e": "pnpm --filter @agrogarantias/web test:e2e",
    "lint": "pnpm -r --filter ./apps/* run lint",
    "typecheck": "pnpm -r --filter ./apps/* run typecheck",
    "format": "prettier --write \"apps/api/{src,test}/**/*.ts\" \"apps/web/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"apps/api/{src,test}/**/*.ts\" \"apps/web/src/**/*.{ts,tsx,css}\"",
    "migration:run": "pnpm --filter @agrogarantias/api migration:run",
    "migration:revert": "pnpm --filter @agrogarantias/api migration:revert",
    "seed": "pnpm --filter @agrogarantias/api seed",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down"
  },
  "packageManager": "pnpm@10.28.0"
}
