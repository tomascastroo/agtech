# =============================================================================
# AgroGarantías — variables de entorno
# Copiar a .env y completar. NUNCA commitear el archivo .env.
# Los valores marcados "dev-only" son rechazados por la API con NODE_ENV=production.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info
# json (por defecto) o pretty (consola legible en desarrollo)
LOG_FORMAT=pretty

# --- PostgreSQL + PostGIS ------------------------------------------------------
POSTGRES_DB=agrogarantias
POSTGRES_USER=agro
POSTGRES_PASSWORD=agro_dev_password
DATABASE_URL=postgres://agro:agro_dev_password@localhost:5432/agrogarantias
DATABASE_POOL_MAX=10

# --- Redis (colas BullMQ) -----------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Almacenamiento de objetos S3-compatible (MinIO en desarrollo) ------------
MINIO_ROOT_USER=agro_minio
MINIO_ROOT_PASSWORD=agro_minio_dev_secret
S3_ENDPOINT=http://localhost:9000
# Endpoint con el que el NAVEGADOR accede a las URLs firmadas.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agrogarantias
S3_ACCESS_KEY=agro_minio
S3_SECRET_KEY=agro_minio_dev_secret
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# --- Autenticación -------------------------------------------------------------
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-jwt-secret-change-me-0001
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# true en cualquier entorno servido por HTTPS
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000

# --- Servicio de visión computacional (FastAPI) --------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-only-ai-service-token
AI_SERVICE_TIMEOUT_MS=30000

# --- Proveedores (adapters) ----------------------------------------------------
# ai-service | mock   (mock = conteo determinístico en proceso, solo desarrollo/tests)
CV_PROVIDER=ai-service
# stac | mock   stac = Sentinel-2 L2A REAL: catálogo STAC + COG de AWS Open Data, NDVI con
#               máscara de nubes calculado en el servicio de visión (sin credenciales).
#               mock = serie SIMULADA para desarrollo sin conexión.
SATELLITE_PROVIDER=stac
AI_SERVICE_SATELLITE_TIMEOUT_MS=180000
# Servicio de visión: yolox (YOLOX-S real, ONNX) | classical (contador OpenCV, solo escenas sintéticas)
AI_SERVICE_DETECTOR=yolox
# auto | earth-search | aws-inventory
AI_SERVICE_SENTINEL_CATALOG=auto
# Nubosidad máxima sobre el lote (%) para que una observación sea utilizable
AI_SERVICE_MAX_CLOUD_COVER=20
# simulated (único gateway disponible en el MVP)
CAMERA_GATEWAY=simulated
# mock (registro SENASA/RENSPA simulado)
REGISTRY_PROVIDER=mock
# Adapter oficial SENASA (REGISTRY_PROVIDER=senasa): requiere convenio institucional.
# Sin estos valores responde "credenciales no configuradas". NUNCA commitear valores reales.
SENASA_API_URL=
SENASA_CLIENT_ID=
SENASA_CLIENT_SECRET=

# --- Red ------------------------------------------------------------------------
# Proxies confiables delante de la API (1 = el BFF de Next.js). En producción, con un ingress
# que fije X-Forwarded-For con la IP real del cliente, usar 2.
TRUST_PROXY_HOPS=1
# Límite de solicitudes por IP y minuto (general y para el login)
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_MINUTE=10

# --- Monitoreo y colas ---------------------------------------------------------
MONITORING_TICK_SECONDS=300
VERIFICATION_JOB_ATTEMPTS=3

# --- Datos demo ----------------------------------------------------------------
# Contraseña de los usuarios demo creados por el seed.
SEED_DEMO_PASSWORD=AgroDemo2026!
# Directorio con imágenes sintéticas (por defecto infra/seed-assets)
# SEED_ASSETS_DIR=
# Botón "Simular solicitud": crea solicitudes con datos ficticios (data_source = DEMO) usando los
# mismos servicios que una solicitud real. Desactivar en producción.
DEMO_MODE=enabled

# --- Frontend ------------------------------------------------------------------
# URL interna con la que Next.js reenvía /api/* al backend
API_INTERNAL_URL=http://localhost:4000
# Estilo de mapa MapLibre en tiempo de ejecución (vacío = OpenStreetMap raster).
# Si se usa otro proveedor, agregar su origen a MAP_TILE_ORIGINS (CSP).
MAP_STYLE_URL=
MAP_TILE_ORIGINS=https://tile.openstreetmap.org
# Orígenes de imágenes firmadas (endpoint público del almacenamiento S3), para la CSP
ASSET_ORIGINS=http://localhost:9000
# Mostrar credenciales demo en la pantalla de login (solo entornos de demostración)
SHOW_DEMO_CREDENTIALS=true
DEMO_LOGIN_EMAIL=maria.lopez@bancodelcampo.com.ar
